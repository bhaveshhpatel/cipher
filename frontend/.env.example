# ── Vercel environment variables ──────────────────────────────────────────
#
# Set these in Vercel → Project Settings → Environment Variables
#
# REQUIRED: Your Railway backend URL (used server-side by the Next.js proxy)
# The browser never calls this URL directly — the proxy does.
NEXT_PUBLIC_API_URL=https://cipher-production-6cd8.up.railway.app

# REQUIRED: Railway WebSocket URL (wss://) for the live signal stream
# Must use wss:// (not ws://) on Vercel since the page is served over HTTPS
NEXT_PUBLIC_WS_URL=wss://cipher-production-6cd8.up.railway.app

# ── Local dev (.env.local) ─────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000
