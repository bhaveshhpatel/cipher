# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Tradier ───────────────────────────────────────────────────────────────────
TRADIER_API_KEY=
TRADIER_STREAM_TOKEN=
TRADIER_ACCOUNT_ID=
# TRADIER_BASE_URL=https://api.tradier.com

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://cipher.vercel.app,http://localhost:3000

# ── Ingestion kill-switch ─────────────────────────────────────────────────────
# Set to false in preview / staging environments to prevent duplicate writes
# to the shared production Supabase tables (flow_events, smart_signals, etc.).
# The API, gate config endpoints, and admin UI remain fully functional.
#
# Production:  INGESTION_ENABLED=true   (or omit — defaults to true)
# Preview:     INGESTION_ENABLED=false
#
# TODO(parallel-schema): Remove once Option A/B parallel schema isolation
# is implemented — writes will be scoped to the preview schema instead.
INGESTION_ENABLED=true
