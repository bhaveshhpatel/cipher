# Tradier
TRADIER_API_KEY=your_tradier_api_key
TRADIER_ACCOUNT_ID=your_account_id
TRADIER_WS_URL=wss://stream.tradier.com/v1/markets/events

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# Groq (swarm engine)
GROQ_API_KEY=your_groq_api_key

# Apex signal engine
APEX_MODE=false                        # set true on apex/engine Railway service
APEX_MAX_SPREAD_PCT=0.15               # 15% max bid-ask spread
APEX_MIN_TRADE_PREMIUM=5000            # $5K minimum per-trade premium
APEX_AGGRESSION_HARD_REJECT=false      # true = hard drop non-aggressive fills
                                       # false = soft flag with 25% conviction haircut
