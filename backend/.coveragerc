[run]
branch = True
source = .
omit =
    tests/*
    tests/integration/*
    # Infrastructure I/O — no unit-testable logic without live sockets/DB.
    services/tradier_stream.py
    services/stream_worker.py
    services/stream_manager.py
    services/flow_store.py
    services/ingestion_config.py
    ingestion/config.py
    # App startup wiring.
    main.py
    # Router handlers tested via HTTP integration fixtures.
    routers/auth.py
    routers/flow.py
    routers/history.py
    routers/smart_signals.py
    # Stub module with no callers yet — removed in SA-3.
    signals/ladder_detector.py

[report]
# fail_under is NOT set here. The 90% gate is enforced in CI only via:
#   coverage report --fail-under=90
# run after the full test suite completes. Setting it here causes
# pytest-cov to apply the gate on every targeted per-file invocation.
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if TYPE_CHECKING:
    @abstractmethod
    pass

[xml]
output = coverage.xml

[json]
output = coverage.json
