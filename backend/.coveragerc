[run]
branch = True
source = .
omit =
    tests/*
    */__pycache__/*
    */migrations/*
    .venv/*
    venv/*
    setup.py
    conftest.py
    # Infrastructure-only I/O workers: no unit-testable logic without live
    # Tradier stream / WebSocket connections. Covered by integration tests.
    services/tradier_stream.py
    services/stream_worker.py
    services/stream_manager.py
    # Application startup wiring — not unit-testable in isolation.
    main.py
    # Supabase-backed stores: all paths require live DB; tested via integration.
    services/flow_store.py
    services/ingestion_config.py
    # ING-007 async Supabase RPC cache: _fetch_from_db requires live PostgREST;
    # pure helpers (_is_fresh, clear_cache) are exercised indirectly via
    # tradier_stream mock path. No unit-testable logic beyond the helpers.
    utils/contract_day_cache.py
    # Router handlers: HTTP-level integration tests cover these; unit
    # coverage here would require full app fixture with auth mocks.
    routers/auth.py
    routers/flow.py
    routers/history.py
    routers/smart_signals.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if TYPE_CHECKING:
    @abstractmethod
    pass
    \.\.\.  # Ellipsis stubs

[xml]
output = coverage.xml

[json]
output = coverage.json
