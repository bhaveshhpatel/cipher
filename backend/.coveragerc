[run]
# Measure only the application source — explicit package list avoids
# accidentally measuring non-Python files or test files themselves.
source =
    config
    main
    core
    execution
    parsers
    routers
    services
    signals
    simulation
    utils

omit =
    # Test files
    tests/*
    tests/**
    */tests/*
    */tests/**
    # Migration scripts
    migrations/*
    migrations/**
    # Virtual environments
    .venv/*
    .venv/**
    venv/*
    venv/**
    # Conftest helpers
    conftest.py
    tests/conftest.py
    # Non-application entry points
    */__main__.py

[report]
# Fail the build if total coverage drops below this threshold.
fail_under = 90

# Show lines that are missing coverage
show_missing = True

# Suppress files with 100% coverage from the terminal report (less noise)
skip_covered = True

# Exclude lines that are genuinely untestable
exclude_lines =
    # Standard pragma
    pragma: no cover
    # Abstract methods
    @abstractmethod
    # Debug-only entry point
    if __name__ == .__main__.
    # Type-checking imports
    if TYPE_CHECKING:
    # Protocol / interface stubs
    \.\.\.\s*$
    pass

[html]
directory = coverage_html
title     = Cipher Backend Coverage Report
