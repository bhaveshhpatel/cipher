[run]
branch = True
source = .
omit =
    tests/*
    */__pycache__/*
    */migrations/*
    .venv/*
    venv/*
    setup.py
    conftest.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if TYPE_CHECKING:
    @abstractmethod
    pass
    \.\.\.  # Ellipsis stubs

[xml]
output = coverage.xml

[json]
output = coverage.json
